minha_lista = []

print("Bem vindo ao gerenciador de lista de compras")
print("Digite 1 para adicionar um item a lista")
print("Digite 2 para remover o ultimo item da lista")
print("Digite 3 para remover um item especifico")
print("Digite 4 para ver a lista")
print("Digite 5 para sair")
escolha = ""


while True:
   escolha = input("Escolha de 1 ate 5: ")
   if escolha != "1" and escolha != "2" and escolha != "3" and escolha != "4" and escolha != "5":
       print("Digite uma opcao valida")
   if escolha == "1":
       item_adicionar = input("Adicione um item: ") 
       minha_lista.append(item_adicionar)
   if escolha == "2":
       minha_lista.pop()
   if escolha == "3":
       item_remover = input("Remova um item: ")
       minha_lista.remove(item_remover)
   if escolha == "4":
      print(f"Sua lista e: {minha_lista}")
   if escolha == "5":
         print("saindo")
         break
   
   
